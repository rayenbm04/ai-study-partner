# Points the app at your backend. For a physical device or simulator this
# must be an address the device can actually reach — "localhost" only
# works when running the web version in a browser on the same machine.
# Find your machine's LAN IP (e.g. `ipconfig getifaddr en0` on macOS) and
# use that instead when testing on a phone via Expo Go.
EXPO_PUBLIC_API_URL=http://localhost:8000
