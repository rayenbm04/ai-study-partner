ENVIRONMENT=development

# Postgres (pgvector extension enabled) — no local/on-disk vector store
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_study_coach

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated — 5173 is rag-frontend's (Vite) dev server, 8081 is the
# new Expo app's web dev server (`npx expo start --web` in mobile/).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Login-attempt limiting ---
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Email verification / password reset ---
# No real email provider is wired up yet — EMAIL_SENDER=logging just logs
# the verification/reset code to the server console (see
# app/services/email/logging_sender.py) instead of actually sending it.
EMAIL_SENDER=logging
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- LLM / embeddings ---
# See docs/LLM_PROVIDERS.md for the free-tier comparison and upgrade path.
# No card required to run this stack: LLM_PROVIDER=groq needs no billing
# account, and EMBEDDING_PROVIDER=local runs sentence-transformers on this
# machine — no key, no card, no cloud call at all (first run downloads the
# model, ~420MB, then it's cached). Gemini remains the default below since
# it's still the strongest free-tier chat model, but as of late 2026 Google
# started requiring a billing account on file for its free tier — switch to
# groq/local above if you'd rather not add one.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Optional: automatically retry against a second provider when LLM_PROVIDER
# is rate-limited, or (for a text-only provider like Cerebras) asked to do a
# vision call it can't handle at all — see FallbackLLMProvider and the
# "Cerebras + Groq" section in docs/LLM_PROVIDERS.md. Empty (default) = no
# fallback, exactly the previous behavior. Only meaningful between two
# OpenAI-compatible providers (groq, cerebras, openrouter, openai).
LLM_FALLBACK_PROVIDER=

GEMINI_API_KEY=your-gemini-api-key-here
# gemini-flash-latest is Google's own always-current alias for the
# recommended flash model — was gemini-2.5-flash until Google pulled that
# from new-user access ahead of its official deprecation date (a live 404
# "no longer available to new users"). An alias sidesteps this specific
# failure mode going forward.
GEMINI_CHAT_MODEL=gemini-flash-latest
# Empty = reuse GEMINI_CHAT_MODEL for simple/mechanical tasks too (concept
# tagging, classification, summaries, flashcard/quiz generation, RAG query
# rewriting — see llm/factory.py's build_simple_llm_provider). No default is
# guessed here since Gemini's lite-tier naming churns; set this once you've
# confirmed one is live, e.g. gemini-flash-lite-latest.
GEMINI_SIMPLE_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

GROQ_API_KEY=your-groq-api-key-here
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Was llama-3.3-70b-versatile until Groq decommissioned it on 2026-08-16;
# openai/gpt-oss-120b is Groq's recommended replacement (the other option
# they listed, qwen/qwen3.6-27b, is already GROQ_VISION_MODEL below).
# Text-only. Scanned/image-only PDF pages and
# standalone image uploads go through a separate vision-capable model —
# Groq's multimodal lineup churns fast (llama-4-scout worked mid-2026, was
# 404ing by August), so check console.groq.com/docs/vision if this one
# starts erroring too.
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Smaller/faster model for the same simple/mechanical task list as
# GEMINI_SIMPLE_CHAT_MODEL above. Tutoring answers and exam-question grading
# still use GROQ_CHAT_MODEL — this is specifically for the high-volume,
# low-reasoning calls (concept tagging in particular fires one batch call
# per handful of chunks during ingestion). Was llama-3.1-8b-instant until
# Groq decommissioned it on 2026-08-16; openai/gpt-oss-20b is Groq's
# recommended replacement.
GROQ_SIMPLE_CHAT_MODEL=openai/gpt-oss-20b

# Cerebras' free tier is unusually generous for a text-only provider:
# gpt-oss-120b at 30 requests/minute, 14.4K requests/day, 1M tokens/day, no
# card required — see docs/LLM_PROVIDERS.md. No vision-capable model in its
# current lineup, so pair LLM_PROVIDER=cerebras with LLM_FALLBACK_PROVIDER=groq
# above if this app will ever see scanned PDFs or image uploads.
CEREBRAS_API_KEY=
CEREBRAS_CHAT_MODEL=gpt-oss-120b
# Smaller/faster Cerebras model for the same simple/mechanical task list as
# GEMINI_SIMPLE_CHAT_MODEL / GROQ_SIMPLE_CHAT_MODEL above.
CEREBRAS_SIMPLE_CHAT_MODEL=llama3.1-8b

OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-2.0-flash-exp:free
# Leave blank to reuse OPENROUTER_CHAT_MODEL for vision too (the default
# above is already multimodal) — only set this if that model stops
# supporting images.
OPENROUTER_VISION_MODEL=
# Empty = reuse OPENROUTER_CHAT_MODEL for simple tasks too — OpenRouter's
# free-tier roster changes too often to pick a safe default here.
OPENROUTER_SIMPLE_CHAT_MODEL=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Leave blank to reuse OPENAI_CHAT_MODEL for vision too — gpt-4o-mini is
# natively multimodal.
OPENAI_VISION_MODEL=
# Empty = reuse OPENAI_CHAT_MODEL for simple tasks too — gpt-4o-mini is
# already the cheap tier, so there's less to gain from splitting further.
OPENAI_SIMPLE_CHAT_MODEL=

ANTHROPIC_API_KEY=

# --- Knowledge Base (Phase 3) ---
STORAGE_DIR=./uploads
MAX_UPLOAD_MB=50

CHUNK_PARENT_CHARS=900
CHUNK_CHILD_CHARS=220
CHUNK_OVERLAP_CHARS=40

CONCEPT_TAG_RELEVANCE_THRESHOLD=0.5
MAX_NEW_CONCEPTS_PER_CHUNK=3
# Parent chunks tagged per LLM call during concept tagging (a background
# follow-up that runs after a document is already "ready" — see
# ingestion_task.py) — the batching is what keeps a 300-page document from
# firing one LLM call per chunk.
CONCEPT_TAG_BATCH_SIZE=6

# --- Cloud API concurrency/retry tuning ---
# Shared by every LLMProvider and EmbeddingProvider implementation. Bounded
# concurrency (never "fire N requests at once with no cap") plus bounded
# retry-with-backoff on 429s is what keeps large-document ingestion from
# either stalling forever or tripping the provider's rate limit.
LLM_MAX_CONCURRENCY=3
EMBEDDING_MAX_CONCURRENCY=5
# Texts per embedding API call — large documents (hundreds/thousands of
# child chunks) are split into batches of this size, batches run concurrently
# up to EMBEDDING_MAX_CONCURRENCY.
EMBEDDING_BATCH_SIZE=100
MAX_RETRIES=3
INITIAL_RETRY_DELAY=15.0
MAX_RETRY_DELAY=90.0

# Re-uploading a file already ingested for the same subject (identical
# sha256 of the raw bytes) returns the existing document instead of
# reprocessing it — avoids burning API quota on accidental re-uploads.
DOCUMENT_DEDUP_ENABLED=true

# --- Usage tracking (architecture, not a paywall) ---
# Every LLM/embedding call and document processed is logged per-user
# regardless of these limits (see UsageService) — enforcement only kicks in
# when USAGE_LIMITS_ENABLED=true. Off by default so it doesn't affect the
# current single-tier product; flip it on once free/premium tiers exist.
USAGE_LIMITS_ENABLED=false
FREE_DAILY_AI_REQUESTS=50
FREE_DAILY_DOCUMENTS=10

# --- RAG chat (Phase 4) ---
# Each technique is its own flag so a slower/stricter free-tier model can have
# some switched off without a code change.
RAG_ENABLE_HYDE=true
RAG_ENABLE_MULTI_QUERY=true
RAG_ENABLE_RERANK=true
RAG_MULTI_QUERY_COUNT=3
RAG_RETRIEVAL_TOP_K=8
RAG_FINAL_CONTEXT_CHUNKS=6
RAG_HISTORY_MESSAGES=6

# --- Summary engine (Phase 5) ---
SUMMARY_MAX_SOURCE_CHARS=16000

# --- Flashcard engine (Phase 6) ---
FLASHCARD_SOURCE_MAX_CHARS=16000
FLASHCARD_DEFAULT_GENERATE_COUNT=10
FLASHCARD_MAX_GENERATE_COUNT=30

# --- Quiz + exam engine (Phase 7) ---
QUIZ_SOURCE_MAX_CHARS=16000
QUIZ_DEFAULT_GENERATE_COUNT=10
QUIZ_MAX_GENERATE_COUNT=30

# --- Progress engine (Phase 8) ---
PROGRESS_TREND_UP_THRESHOLD=1.0
PROGRESS_TREND_DOWN_THRESHOLD=1.0
WEAK_CONCEPT_MIN_ERROR_COUNT=2
WEAK_CONCEPT_ERROR_RATE_THRESHOLD=0.5
WEAK_CONCEPT_SLOW_RESPONSE_SECONDS=60.0
WEAK_CONCEPT_DECAY_DROP_THRESHOLD=15.0
WEAK_CONCEPT_DECAY_MIN_PREVIOUS_SCORE=60.0

# --- Planning engine (Phase 9) ---
PLANNING_DEFAULT_SESSION_MINUTES=25
PLANNING_DEFAULT_PLAN_DAYS=14